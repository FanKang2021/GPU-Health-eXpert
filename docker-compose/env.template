# GHX Docker Compose 环境配置模板
# 复制此文件为 .env 并修改相应配置

# ===================
# 基础配置
# ===================
COMPOSE_PROJECT_NAME=ghx
COMPOSE_FILE=docker-compose.yml

# ===================
# Kubernetes 配置
# ===================
# kubeconfig文件路径 (相对于docker-compose目录)
KUBECONFIG_PATH=~/.kube/config

# Kubernetes命名空间
K8S_NAMESPACE=gpu-health-expert

# ===================
# 服务配置
# ===================
# Flask环境配置
FLASK_ENV=production
FLASK_DEBUG=0

# 数据存储路径 (相对于docker-compose目录)
SHARED_DATA_PATH=./data/shared
LOGS_PATH=./data/logs

# ===================
# 网络配置
# ===================
# 服务端口配置
GHX_SERVER_PORT=5000
GHX_DASHBOARD_PORT=3000

# CORS跨域配置 (多个地址用逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://ghx-dashboard:3000

# ===================
# 镜像配置
# ===================
# 可以指定特定的镜像标签
GHX_CHECK_IMAGE=kang2023/ghx-check:latest
GHX_SERVER_IMAGE=ghx-server:latest
GHX_DASHBOARD_IMAGE=ghx-dashboard:latest

